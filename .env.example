# ============================================================
#  MAILFLOW — Template de configuration
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ------------------------------------------------------------
# MICROSOFT GRAPH API (boite Outlook de l'utilisateur)
# ------------------------------------------------------------
MS_TENANT_ID=VOTRE_TENANT_ID
MS_CLIENT_ID=VOTRE_CLIENT_ID
MS_CLIENT_SECRET=VOTRE_CLIENT_SECRET
MS_USER_EMAIL=adresse_outlook@exemple.fr

# ------------------------------------------------------------
# GOOGLE APIs
# Chemin vers le fichier JSON du compte de service Google
# (téléchargeable depuis Google Cloud Console)
# À déposer dans : src/config/credentials/
# ------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=src/config/credentials/google_service_account.json

# ID du Google Sheet (dans l'URL : /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=VOTRE_GOOGLE_SHEET_ID

# Nom exact de l'onglet dans le Google Sheet
GOOGLE_SHEET_TAB=Liste_envois_MEMENTO

# ID du Google Doc ContenuMessage dans Google Drive
# (dans l'URL Drive : /file/d/<ID>/view)
GOOGLE_DOC_CONTENU_MESSAGE_ID=VOTRE_CONTENU_MESSAGE_FILE_ID

# ------------------------------------------------------------
# LLM LOCAL (Ollama sur VPS)
# Modèle servi par Ollama — format : ollama/<nom_modele>
# ------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=ollama/qwen2.5:14b

# ------------------------------------------------------------
# PARAMETRES AGENTS
# ------------------------------------------------------------
# Intervalle de polling de l'agent analyseur_mail (en secondes)
ANALYSEUR_MAIL_INTERVAL=300

# Intervalle de polling de l'agent expediteur (en secondes)
EXPEDITEUR_INTERVAL=420

# Adresse expéditrice filtrée (emails WordPress entrants)
FILTER_SENDER=formulaire@exemple.fr
