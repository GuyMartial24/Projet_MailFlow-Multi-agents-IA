[Unit]
Description=MailFlow â€” Agents IA surveillance Outlook et envoi Memento
Documentation=https://github.com/GuyMartial24/Projet_MailFlow-Multi-agents-IA
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Projets_en_Production/MailFlow
ExecStart=/home/ubuntu/Projets_en_Production/MailFlow/.venv/bin/python main.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mailflow
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
